[global]
monitor = 0
follow = mouse
width = 320
origin = top-right
offset = 20x20

font = JetBrainsMono 10
line_height = 3

background = "#1e1e2edd"
foreground = "#cdd6f4"
frame_color = "#89b4fa"

frame_width = 2
corner_radius = 12
padding = 12
horizontal_padding = 12

separator_height = 2
separator_color = frame

transparency = 0
idle_threshold = 120
markup = full

format = "<b>%s</b>\n%b"
